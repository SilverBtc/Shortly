# ==== TikTok Studio — variables d'environnement ====
# Copier vers .env puis adapter.

# --- Backend ---
TIKTOK_DATABASE_URL=sqlite+aiosqlite:///./data/app.db
TIKTOK_LLM_BASE_URL=http://localhost:11434/v1
TIKTOK_LLM_API_KEY=ollama
TIKTOK_LLM_MODEL=qwen2.5:7b
TIKTOK_TTS_VOICE=fr-FR-HenriNeural
TIKTOK_TTS_RATE=+0%
TIKTOK_TTS_PITCH=+0Hz
TIKTOK_WHISPER_MODEL=base
TIKTOK_WHISPER_DEVICE=cpu
TIKTOK_DISCORD_WEBHOOK_URL=
TIKTOK_PUBLIC_BASE_URL=http://localhost:8000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
